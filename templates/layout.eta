<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= it.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="<%= it.root %>assets/site.css">
<% if (it.stylesheet) { %>
  <link rel="stylesheet" href="<%= it.root %>assets/<%= it.stylesheet %>">
<% } %>
</head>
<body<% if (it.bodyData) { %><% for (const [key, value] of Object.entries(it.bodyData)) { %> data-<%= key %>="<%= value %>"<% } %><% } %>>
  <div class="wrap">
<%~ it.body %>
  </div>
<% if (it.script) { %>
  <script src="<%= it.root %>assets/<%= it.script %>"></script>
<% } %>
</body>
</html>
